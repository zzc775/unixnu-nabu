CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="BEC2158A-350E-4F2E-B87E-A0E69FB0BDEA"
# CONFIG_XNU_NATIVE_UFS is off while the boot is being brought up. Enabling it
# links build/storage-abi/IOBlockStorageDevice-reference.o into the kernel so that
# NativeUfsBlock can derive from IOBlockStorageDevice, but prelink also packs
# com.apple.iokit.IOStorageFamily, which owns that class. OSMetaClass then panics:
#   Kext com.apple.iokit.IOStorageFamily class IOBlockStorageDevice is a duplicate;
#   kext __kernel__ already has a class with this name
# Storage is not needed this early; re-enable it once the kernel reaches userland.
# CONFIG_XNU_NATIVE_UFS=y

# The board-side display provider. This is what IOSurface needs in order to have a
# display to attach to; without it the boot stops at
# IOsurfaceRoot::installMemoryRegions(). The archive comes from
# package/LegacyDisplayProbe.cpp via scripts/build-native-legacy-display.py, which is
# listed last in [kernel] archives of board.toml.
#
# The driver also gates most of its own work behind boot arguments it reads with
# PE_parse_boot_argn, so the payload must pass offline-legacy-gop / -register /
# -validate / -transfer / -retire, otherwise start() fails or backend_guard(84) panics.
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y

