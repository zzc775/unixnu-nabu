CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="BEC2158A-350E-4F2E-B87E-A0E69FB0BDEA"
# Enabling NativeUfs links build/storage-abi/IOBlockStorageDevice-reference.o into the
# kernel so that NativeUfsBlock can derive from IOBlockStorageDevice, while prelink also
# packs com.apple.iokit.IOStorageFamily (pulled in by apfs), which owns that class.
# OSMetaClass may then panic with:
#   Kext com.apple.iokit.IOStorageFamily class IOBlockStorageDevice is a duplicate
# This is the experiment: enable it and see whether the reference object and the packed
# kext can coexist on hardware. Storage is not needed this early, so the previous state
# (off) is the known-good one and lives on the retail-6gb branch.
CONFIG_XNU_NATIVE_UFS=y

